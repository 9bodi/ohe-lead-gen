// Schéma de données pour ohe-lead-gen (version Freemium)
// Test diagnostic gratuit, hébergé sur le site OHé,
// avec génération de leads via capture email

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Campaign — une source / canal de leads
// ============================================================
// type 'web_freemium' = leads du site OHé (par défaut)
// type 'event'       = leads d'un salon (créés via backoffice)
//
// Permet de distinguer les leads selon leur origine.
model Campaign {
  id          String       @id @default(cuid())
  name        String       // ex: "Web Freemium" ou "Salon RH Paris 2026"
  slug        String       @unique // ex: "web-freemium" ou "paris-rh-2026"
  type        CampaignType @default(web_freemium)
  location    String?      // ex: "Porte de Versailles, Hall 4" (uniquement pour les events)
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  leads       Lead[]

  @@index([slug])
  @@index([isActive])
  @@index([type])
}

enum CampaignType {
  web_freemium
  event
}

// ============================================================
// Lead — un visiteur qui a complété le test
// ============================================================
// Capture minimale : email + opt-in marketing
// + tracking UTM pour mesurer l'efficacité des sources
model Lead {
  id                  String   @id @default(cuid())
  campaignId          String
  campaign            Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // === Identifiant principal ===
  email               String   // collecté sous intérêt légitime (délivrance du résultat)

  // === Identité facultative (capture freemium) ===
  firstName           String?  // facultatif
  lastName            String?  // facultatif
  organization        String?  // facultatif

  // === Consentements RGPD ===
  marketingOptIn      Boolean  @default(false) // case "J'accepte de recevoir les infos OHé"

  // === Tracking source ===
  utmSource           String?  // ex: 'linkedin', 'newsletter'
  utmCampaign         String?  // ex: 'oct2026'
  utmMedium           String?  // ex: 'social', 'email'

  createdAt           DateTime @default(now())

  result              FreemiumResult?

  @@index([campaignId])
  @@index([email])
  @@index([createdAt])
  @@index([utmSource])
}


// ============================================================
// FreemiumResult — résultat du test (un test = un résultat)
// ============================================================
model FreemiumResult {
  id                    String   @id @default(cuid())
  leadId                String   @unique
  lead                  Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // === Scores procéduraux ===
  // Bloc 1 = Accords des mots (8 questions)
  // Bloc 2 = Conjugaison des verbes (8 questions)
  block1Correct         Int      // nombre de bonnes réponses au bloc 1 (0-8)
  block1Score           Float    // 0 / 0.5 / 0.75 / 1 (selon les seuils du CDC)
  block1Level           BlockLevel  // non_maitrise / fragile / fonctionnel / maitrise

  block2Correct         Int
  block2Score           Float
  block2Level           BlockLevel

  // === Score déclaratif : profil ADAPTATION ===
  // Score sur 3 (Q1, Q2, Q3 - axe ADAPTATION)
  adaptationScore       Int      // 0 à 3
  adaptationProfile     AdaptationProfile // adapted / not_adapted

  // === Réponses détaillées (audit, debug, analyse future) ===
  // Format JSON : { q1: { questionId, choiceKey, isCorrect, answeredInMs }, ... }
  rawAnswers            Json

  // === Métadonnées ===
  durationMs            Int      // temps total passé sur le test
  completedAt           DateTime @default(now())

  @@index([completedAt])
  @@index([adaptationProfile])
}

enum BlockLevel {
  non_maitrise   // 0-2/8  → 0 point   → rouge
  fragile        // 3-4/8  → 0.5 point → orange
  fonctionnel    // 5-6/8  → 0.75 point→ bleu
  maitrise       // 7-8/8  → 1 point   → vert
}

enum AdaptationProfile {
  adapted        // score 2-3/3 → formation adaptée
  not_adapted    // score 0-1/3 → formation peu adaptée
}

// ============================================================
// ContactRequest — demande de contact (B2B ou particulier)
// ============================================================
// Pour les visiteurs qui veulent un diagnostic complet
// pour leur équipe / entreprise, ou pour eux-mêmes (particulier).
// Séparé de Lead car ce sont des contacts qualifiés qui n'ont
// pas forcément passé le test.
model ContactRequest {
  id                String   @id @default(cuid())

  // === Identité ===
  firstName         String
  lastName          String
  email             String   // pro ou perso selon le type
  phone             String?  // facultatif, format libre
  company           String?  // facultatif (un particulier n'en a pas)

  // === Qualification facultative ===
  jobTitle          String?  // rôle / fonction
  teamSize          String?  // ex: "1-10", "11-50", "51-200", "200+"
  message           String?  // texte libre, max 500 chars

  // === Origine de la demande ===
  requestType       String?  // "btoc" (particulier) ou "btob" (entreprise)
  // === Profil B2C (si requestType = "btoc") ===
  profile           String?  // "salarie", "etudiant", "demandeur_emploi", "independant", "autre"
  
  // === Lien optionnel vers le test freemium passé ===
  // Si le visiteur a fait le freemium avant de contacter, on lie
  // les deux pour avoir le contexte complet côté backoffice
  freemiumResultId  String?

  // === Métadonnées ===
  createdAt         DateTime @default(now())

  @@index([email])
  @@index([createdAt])
  @@index([freemiumResultId])
}
